# Example environment variables for local development
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:55432/api_gateway
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
SECRET_KEY=changeme
JWT_ISSUER=https://auth.example.com/
JWT_SECRET=changeme
JWT_AUDIENCE=tai-api
JWT_ALGORITHMS=HS256,RS256,EdDSA
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
JWT_MFA_CHALLENGE_TTL_MINUTES=5
JWT_RS256_PRIVATE_KEY=
JWT_RS256_PUBLIC_KEY=
JWT_EDDSA_PRIVATE_KEY=
JWT_EDDSA_PUBLIC_KEY=
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_NAME=refresh_token
CSRF_COOKIE_NAME=csrf_token
PASSWORD_RESET_TTL_MINUTES=30
TOTP_ISSUER=TAI Platform
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=

# App settings
APP_ENV=development
LOG_LEVEL=INFO
AUTH_RATE_LIMIT_AUTH_PER_MIN=100
AUTH_RATE_LIMIT_ANON_PER_MIN=10

# Email settings (Google SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_NAME=TAI

# MinIO object storage settings
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=tai-documents
MINIO_SECURE=false
